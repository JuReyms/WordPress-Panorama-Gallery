# Fichiers de développement, absents du zip de l'extension (git archive).
.gitattributes export-ignore
.gitignore     export-ignore
.github        export-ignore
bin            export-ignore
artefact.xml   export-ignore
ROADMAP.md     export-ignore

# Les scripts shell gardent des fins de ligne LF, même sous Windows.
*.sh text eol=lf
